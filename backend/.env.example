# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB local or MongoDB Atlas)
# Example local: mongodb://127.0.0.1:27017/akshitha_edutech
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/akshitha_edutech?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/akshitha_edutech

# Authentication
# IMPORTANT: Generate a strong, random 64-character secret for production
JWT_SECRET=super_secret_jwt_key_change_me_in_production_min32chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=token

# CORS - Comma-separated list of allowed origins
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Uploads (Resumes)
MAX_FILE_SIZE_MB=2
UPLOAD_DIR=uploads/resumes

# Initial Administrator Seed (used by npm run seed:admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@akshithaedutech.example
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_PHONE=9876543210
